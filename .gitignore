# Build output — regenerate with ./build.sh
build/
*.o
*.swiftmodule
.build/

# Spike build output — regenerate with the per-spike build.sh
spikes/*/build/

# Python bytecode — generate_icon.py imports generate_art.py, which makes one
__pycache__/

# macOS
.DS_Store

# Editor
.vscode/
*.xcuserstate
xcuserdata/

# Local settings that should not be shared
.claude/settings.local.json

# Agent worktrees — these are separate checkouts, never part of the repo
.claude/worktrees/

# Distributable disk images and Windows packages — build with tools/make-dmg.sh
# and windows/build.ps1
dist/

# .NET build output — regenerate with windows/build.ps1
[Bb]in/
[Oo]bj/
