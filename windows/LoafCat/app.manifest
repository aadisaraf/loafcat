<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="LoafCat.app" />

  <!-- asInvoker, and it must stay that way.

       loafcat needs no elevation for anything it does, and an app that asks for it
       gets a UAC prompt on every launch — the Windows equivalent of the permission
       dialogs the whole design exists to avoid. Elevating would also BREAK the app:
       an elevated process cannot receive drag-and-drop or interact normally with
       the unelevated shell, and GetLastInputInfo would start missing input aimed at
       unelevated windows. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- DPI awareness is deliberately NOT declared here. The Windows Forms SDK refuses
       to build a project that sets it in both places (WFAC010) and wants it as the
       `ApplicationHighDpiMode` property instead, which is where the reasoning lives.
       See LoafCat.csproj. -->

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
