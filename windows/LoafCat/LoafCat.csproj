<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <!-- Lower case, because that is how the project spells its own name everywhere
         else. This is the file name in the zip, the file name the release publishes,
         the file name it installs itself under, and — with extensions hidden, which is
         the Windows default — the whole of what Explorer shows. Spelling it two ways
         is how an app ends up being called something different in every list that
         names it. -->
    <AssemblyName>loafcat</AssemblyName>
    <RootNamespace>LoafCat</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Per-monitor DPI aware, v2. Load-bearing for pixel art.

         Without it Windows bitmap-stretches the whole window by the display scale
         factor — a 150% display would resample the cat by 1.5x with bilinear
         filtering, which is precisely the mush the entire art pipeline exists to
         prevent, and no amount of care downstream gets it back.

         Declaring awareness means one unit we draw is one physical pixel, so the
         integer render scale in Settings is the ONLY magnification in the chain and it
         is always nearest-neighbour. The cost is that the cat does not automatically
         get bigger on a high-DPI display, so first run picks a starting scale from the
         monitor's DPI instead — see CatController.ResolveScale.

         It has to live here rather than in app.manifest: the Windows Forms SDK errors
         (WFAC010) if the manifest declares it too. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\icon\loafcat.ico</ApplicationIcon>

    <!-- Must match CFBundleShortVersionString in build.sh. Nothing syncs the two
         automatically; the release workflow refuses to publish if either disagrees
         with the tag, which catches it at the only moment it matters. -->
    <Version>0.2.1</Version>
    <Company>loafcat</Company>
    <Product>loafcat</Product>
    <!-- Becomes FileDescription in the version resource, which is the string Windows
         shows wherever it has to name a running app: Task Manager, the startup apps
         list, the tray icon settings. Without it the SDK uses the assembly name, and
         anything that cannot find a description at all falls back to the file name,
         extension and all. It is the app's name to the shell, so it is spelt the way
         the app spells it everywhere else. -->
    <AssemblyTitle>loafcat</AssemblyTitle>
    <Description>A pixel cat that reacts to your cursor, your typing, and Claude Code.</Description>

    <!-- Unsafe is used in exactly one place: the compositor's inner blit loop, which
         writes a few hundred thousand pixels per frame at 120Hz. See CatView.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- win-x64 only for now. arm64 Windows runs x64 under emulation, and a pixel
         compositor at 120Hz is not where that cost shows up; a native arm64 build
         is a one-line addition when there is a machine to verify it on. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Lets `dotnet build` work from macOS and Linux, so the port can be compiled
         and reviewed without a Windows machine. Windows ignores it. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Warnings are errors: this is a port, and a mechanical translation is exactly
         the situation where a quietly-ignored nullable warning becomes a null cat. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- The art and the hook script are read from disk when they are next to the
       executable — which is how the .zip ships, and what lets someone drop a
       community theme into assets\themes\ without repackaging anything.

       They are ALSO embedded, so a bare LoafCat.exe on its own is a complete app.
       That is the difference between "download and run" and "download, extract, keep
       the folder together", and for one file you hand to a friend it matters. The
       whole payload is 852KB against a 66MB runtime, so it costs nothing worth
       counting.

       On-disk always wins; the embedded copy is extracted once, on first run, only
       when there is nothing beside the executable. See Assets.Root(). -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\**\*">
      <LogicalName>loafcat.payload/assets/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\hooks\loafcat-hook.ps1">
      <LogicalName>loafcat.payload/hooks/loafcat-hook.ps1</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
